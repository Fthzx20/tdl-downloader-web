# ==========================================
# Tidal Rip Web - Environment Variables Template
# ==========================================

# Server Configuration
PORT=8000
PYTHONUNBUFFERED=1
MAX_CONCURRENT_DOWNLOADS=2

# Directories (Optional - defaults to OS temp/music dirs)
# TEMP_DIR=/tmp/Tidal_Temp_Zips
# DOWNLOAD_DIRECTORY=/tmp/Tidal_Downloads
# CONFIG_DIR=/home/appuser/.tidal_rip

# Cloudflare R2 Storage (Optional)
# If configured, downloads will be uploaded to R2 and served via presigned URLs
R2_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=

# Tidal Initial Session Seed (Optional)
# TIDAL_ACCESS_TOKEN=
# TIDAL_REFRESH_TOKEN=
# TIDAL_USER_ID=

# Frontend Configuration (for web_frontend/.env.local)
# NEXT_PUBLIC_API_BASE=http://localhost:8000
